---
// TodaySection.astro — Sección HOY (rediseño editorial)
import type { FeriaDay } from "../data/feria";
import ActivityRow from "./ActivityRow.astro";

interface Props {
  day: FeriaDay;
  dayIndex: number;
  totalDays: number;
}

const { day, dayIndex, totalDays } = Astro.props;

const fullDate = new Date(day.date + "T12:00:00");
const weekdayLong  = fullDate.toLocaleDateString("es-HN", { weekday: "long" });
const weekdayCap   = weekdayLong.charAt(0).toUpperCase() + weekdayLong.slice(1);
const monthName    = fullDate.toLocaleDateString("es-HN", { month: "long" });
const dayNumber    = day.dayNumber;
const dayOrdinal   = dayIndex + 1;

// Determinar la actividad "próxima" basándonos en la hora actual
// En producción esto usaría la hora real; aquí lo simulamos con la primera actividad
const now = new Date();
const nowMinutes = now.getHours() * 60 + now.getMinutes();

function parseTime(timeStr: string): number {
  const [timePart, ampm] = timeStr.split(" ");
  let [h, m] = timePart.split(":").map(Number);
  if (ampm === "PM" && h !== 12) h += 12;
  if (ampm === "AM" && h === 12) h = 0;
  return h * 60 + (m || 0);
}

let nextActivityIndex = -1;
for (let i = 0; i < day.activities.length; i++) {
  const actMinutes = parseTime(day.activities[i].time);
  if (actMinutes > nowMinutes) {
    nextActivityIndex = i;
    break;
  }
}
// Si todas pasaron, no marcamos ninguna; si ninguna empezó aún, marcamos la primera
if (nextActivityIndex === -1 && nowMinutes < parseTime(day.activities[0].time)) {
  nextActivityIndex = 0;
}
---

<section id="hoy" class="today-section section-light" aria-label="Actividades de hoy">
  <div class="container">

    <!-- Header de sección: label + identidad del día -->
    <div class="today-header">
      <div class="today-header-left">
        <p class="section-eyebrow today-eyebrow">¿Qué hay hoy?</p>
        <p class="today-day-label">Día {dayOrdinal} de {totalDays}</p>
      </div>
      <div class="today-header-right" aria-label={`${weekdayCap} ${dayNumber} de ${monthName}`}>
        <span class="today-weekday">{weekdayCap}</span>
        <span class="today-number">{dayNumber}</span>
        <span class="today-month">{monthName}</span>
      </div>
    </div>

    <!-- Divider -->
    <hr class="section-divider today-divider" />

    <!-- Lista de actividades -->
    <div role="list" aria-label={`Actividades del ${weekdayCap} ${dayNumber}`} class="today-list">
      {day.activities.map((act, i) => (
        <div role="listitem">
          <ActivityRow
            activity={act}
            isNext={i === nextActivityIndex}
          />
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .today-section {
    padding-block: 3rem 3.5rem;
    border-top: 1px solid var(--color-border-light);
  }

  /* ─── Section header ─────────────────────────────── */
  .today-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .today-header-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.25rem;
  }

  .today-eyebrow {
    color: var(--color-text-muted-dark);
    margin: 0;
  }

  .today-day-label {
    font-size: 0.875rem;
    color: var(--color-text-muted-dark);
    margin: 0;
  }

  .today-header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1;
    gap: 0.1rem;
    flex-shrink: 0;
  }

  .today-weekday {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 8vw, 2.5rem);
    font-weight: 800;
    color: var(--color-fire);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .today-number {
    font-family: var(--font-display);
    font-size: clamp(3rem, 14vw, 5rem);
    font-weight: 900;
    line-height: 0.85;
    color: var(--color-text-dark);
    letter-spacing: -0.04em;
  }

  .today-month {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted-dark);
    text-transform: capitalize;
    letter-spacing: 0.04em;
  }

  /* ─── Divider ────────────────────────────────────── */
  .today-divider {
    margin-bottom: 0;
  }

  /* ─── List ───────────────────────────────────────── */
  .today-list {
    /* El padding crea espacio visual alrededor de la lista */
  }
</style>
