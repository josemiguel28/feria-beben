---
// NavBar.astro — Fondo claro, editorial, sin colores de UI
interface Props {
  shortName: string;
}
const { shortName } = Astro.props;
---

<header class="navbar" role="banner">
  <div class="navbar-inner container">
    <!-- Logo -->
    <a href="/" class="navbar-logo" aria-label={`${shortName} — Inicio`}>
      <img src="/logo.jpg" alt="Logo" class="logo-img" width="60" height="60" />
    </a>

    <!-- Desktop nav links -->
    <nav class="navbar-nav" aria-label="Navegación principal">
      <a href="#hoy" class="nav-link">Hoy</a>
      <a href="#proximo" class="nav-link">Programa</a>
      <a href="#pueblo" class="nav-link">El Pueblo</a>
      <a href="#info" class="nav-link">Info</a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      class="hamburger"
      id="nav-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      type="button"
    >
      <span class="ham-line" aria-hidden="true"></span>
      <span class="ham-line" aria-hidden="true"></span>
      <span class="ham-line" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile menu drawer -->
  <nav
    id="mobile-menu"
    class="mobile-menu"
    aria-label="Menú de navegación"
    aria-hidden="true"
  >
    <div class="container">
      <a href="#hoy" class="mobile-link" id="mnav-hoy">Hoy</a>
      <a href="#proximo" class="mobile-link" id="mnav-programa">Programa</a>
      <a href="#pueblo" class="mobile-link" id="mnav-pueblo">El Pueblo</a>
      <a href="#info" class="mobile-link" id="mnav-info">Información</a>
    </div>
  </nav>
</header>

<div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById("nav-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const backdrop = document.getElementById("nav-backdrop")!;
  const links = menu.querySelectorAll(".mobile-link");

  const open = () => {
    menu.classList.add("is-open");
    backdrop.classList.add("is-visible");
    toggle.setAttribute("aria-expanded", "true");
    menu.setAttribute("aria-hidden", "false");
    toggle.setAttribute("aria-label", "Cerrar menú");
    toggle.classList.add("is-open");
    document.body.style.overflow = "hidden";
  };

  const close = () => {
    menu.classList.remove("is-open");
    backdrop.classList.remove("is-visible");
    toggle.setAttribute("aria-expanded", "false");
    menu.setAttribute("aria-hidden", "true");
    toggle.setAttribute("aria-label", "Abrir menú");
    toggle.classList.remove("is-open");
    document.body.style.overflow = "";
  };

  toggle.addEventListener("click", () =>
    menu.classList.contains("is-open") ? close() : open(),
  );
  backdrop.addEventListener("click", close);
  links.forEach((l) => l.addEventListener("click", close));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
</script>

<style>
  /* ─── Shell ───────────────────────────────────── */
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 1rem;
  }

  /* ─── Logo ────────────────────────────────────── */
  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  /* Pequeño acento naranja — único color de identidad en el nav */
  .logo-mark {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1;
    white-space: nowrap;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  /* ─── Desktop nav ─────────────────────────────── */
  .navbar-nav {
    display: none;
    align-items: center;
    gap: 0;
  }

  @media (min-width: 640px) {
    .navbar-nav {
      display: flex;
    }
    .hamburger {
      display: none;
    }
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    transition: color 0.15s ease;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  /* ─── Hamburger ───────────────────────────────── */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    border-radius: 4px;
    flex-shrink: 0;
    transition: background-color 0.15s ease;
  }

  .hamburger:hover {
    background-color: rgb(0 0 0 / 0.04);
  }

  .ham-line {
    display: block;
    width: 100%;
    height: 1.5px;
    background-color: var(--color-ink);
    border-radius: 2px;
    transform-origin: center;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
  }

  .hamburger.is-open .ham-line:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .hamburger.is-open .ham-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger.is-open .ham-line:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ─── Mobile menu ─────────────────────────────── */
  .mobile-menu {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.28s ease;
  }

  @media (min-width: 640px) {
    .mobile-menu {
      display: none;
    }
  }

  .mobile-menu.is-open {
    max-height: 300px;
  }

  .mobile-menu .container {
    display: flex;
    flex-direction: column;
    padding-block: 0.5rem 1rem;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-border);
    min-height: 52px;
    transition: color 0.15s ease;
  }

  .mobile-link:last-child {
    border-bottom: none;
  }
  .mobile-link:hover {
    color: var(--color-accent);
  }

  /* ─── Backdrop ────────────────────────────────── */
  .nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgb(0 0 0 / 0.25);
    z-index: 99;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .nav-backdrop.is-visible {
    display: block;
    opacity: 1;
  }

  @media (min-width: 640px) {
    .nav-backdrop {
      display: none !important;
    }
  }
</style>
