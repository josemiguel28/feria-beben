---
// ExploreSection.astro
// Bottom section: access to restaurants, cafes, hotels, and landmarks
// Kept intentionally simple — these link to future sub-pages

interface ExploreItem {
  href: string;
  emoji: string;
  label: string;
  sublabel: string;
}

const items: ExploreItem[] = [
  { href: "/comer",     emoji: "🍽️", label: "Dónde comer",   sublabel: "Restaurantes típicos"   },
  { href: "/cafes",     emoji: "☕", label: "Cafeterías",     sublabel: "Café y meriendas"       },
  { href: "/hospedaje", emoji: "🛏️", label: "Hospedaje",      sublabel: "Hoteles y posadas"      },
  { href: "/pueblo",    emoji: "📍", label: "Conoce el pueblo", sublabel: "Lugares de interés"   },
];
---

<section class="explore-section" aria-label="Explora el pueblo">
  <div class="page-container">

    <header class="explore-header">
      <span class="section-label explore-label">Explora el pueblo</span>
      <p class="explore-subtitle">Todo lo que necesitas durante la feria</p>
    </header>

    <nav class="explore-grid" aria-label="Secciones del sitio">
      {items.map((item) => (
        <a href={item.href} class="explore-card" aria-label={item.label}>
          <span class="explore-emoji" aria-hidden="true">{item.emoji}</span>
          <span class="explore-label-text">{item.label}</span>
          <span class="explore-sublabel">{item.sublabel}</span>
          <svg class="explore-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L9.19 8 6.22 5.03a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
          </svg>
        </a>
      ))}
    </nav>

  </div>
</section>

<style>
  .explore-section {
    background-color: var(--color-bg);
    padding-block: 1.5rem 2.5rem;
    border-top: 3px solid var(--color-border);
  }

  .explore-header {
    margin-bottom: 1rem;
  }

  .explore-label {
    display: block;
    margin-bottom: 0.25rem;
  }

  .explore-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ─── Grid: 2 columns on mobile ─────────────── */
  .explore-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.625rem;
  }

  /* ─── Individual card ────────────────────────── */
  .explore-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: var(--color-text);
    min-height: 80px; /* generous touch area */
    position: relative;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, translate 0.15s ease;
  }

  .explore-card:hover,
  .explore-card:focus-visible {
    border-color: var(--color-accent-light);
    box-shadow: 0 4px 12px rgb(212 80 10 / 0.1);
    translate: 0 -1px;
    outline: none;
  }

  .explore-card:active {
    translate: 0 0;
    box-shadow: none;
  }

  .explore-emoji {
    font-size: 1.5rem;
    line-height: 1;
    display: block;
    margin-bottom: 0.25rem;
  }

  .explore-label-text {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text);
  }

  .explore-sublabel {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  .explore-arrow {
    position: absolute;
    top: 0.875rem;
    right: 0.75rem;
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-text-subtle);
    transition: color 0.15s ease;
  }

  .explore-card:hover .explore-arrow {
    color: var(--color-accent);
  }
</style>
