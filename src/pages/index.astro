---
import BaseLayout from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import HeroSection from "../components/HeroSection.astro";
import TodaySection from "../components/TodaySection.astro";
import UpcomingSection from "../components/UpcomingSection.astro";
import PuebloSection from "../components/PuebloSection.astro";
import InfoSection from "../components/InfoSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { feria } from "../data/feria";

// ─── Determinar día actual ───────────────────────────────────────────────────
const todayISO = new Date().toISOString().split("T")[0];

let todayIndex = feria.days.findIndex((d) => d.date === todayISO);

// Fallback para demo: Martes 22 (índice 2) — el día de demostración del diseño
if (todayIndex === -1) {
  todayIndex = 2;
}

const todayDay   = feria.days[todayIndex];
const upcomingDays = feria.days.slice(todayIndex + 1);
const dayNumber    = todayIndex + 1;

// ¿La feria está activa? (hoy está dentro del rango de fechas)
const todayDate = new Date(todayISO + "T12:00:00");
const startDate = new Date(feria.startDate + "T12:00:00");
const endDate   = new Date(feria.endDate   + "T12:00:00");
const isActive  = todayDate >= startDate && todayDate <= endDate;

// ─── Meta dinámica ───────────────────────────────────────────────────────────
const fullDate = new Date(todayDay.date + "T12:00:00");
const dayLabel = fullDate.toLocaleDateString("es-HN", { weekday: "long", day: "numeric", month: "long" });
const dayLabelCap = dayLabel.charAt(0).toUpperCase() + dayLabel.slice(1);

const pageTitle       = `Feria Patronal de San Marcos 2026 — ${dayLabelCap}`;
const pageDescription = `Programa de actividades para el ${dayLabelCap} en la Feria Patronal de San Marcos de la Sierra 2026. Consulta actividades, restaurantes y más.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- Skip to main content (accessibility) -->
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

  <!-- ① Navbar -->
  <NavBar feriaName={feria.name} />

  <main id="main-content">

    <!-- ② Hero -->
    <HeroSection
      feriaName={feria.name}
      town={feria.town}
      year={feria.year}
      startDate={feria.startDate}
      endDate={feria.endDate}
      currentDayNumber={dayNumber}
      totalDays={feria.totalDays}
      isActive={isActive}
    />

    <!-- ③ Hoy -->
    <TodaySection
      day={todayDay}
      dayIndex={todayIndex}
      totalDays={feria.totalDays}
    />

    <!-- ④ Próximamente -->
    <UpcomingSection days={upcomingDays} />

    <!-- ⑤ Descubre el pueblo -->
    <PuebloSection />

    <!-- ⑥ Información práctica -->
    <InfoSection />

  </main>

  <!-- ⑦ Footer -->
  <SiteFooter
    feriaName={feria.name}
    town={feria.town}
    year={feria.year}
    patronSaint={feria.patronSaint}
  />

</BaseLayout>

<style>
  /* Skip link — visible solo en focus (accesibilidad) */
  .skip-link {
    position: absolute;
    top: -999px;
    left: 1rem;
    z-index: 200;
    background: var(--color-fire);
    color: #fff;
    padding: 0.625rem 1.25rem;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    border-radius: 0 0 6px 6px;
  }

  .skip-link:focus {
    top: 0;
  }
</style>
