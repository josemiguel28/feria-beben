---
// UpcomingSection.astro — Próximas actividades (estilo editorial limpio)
import type { FeriaDay } from "../data/feria";
import ActivityRow from "./ActivityRow.astro";

interface Props {
  days: FeriaDay[];   // días DESPUÉS de hoy, en orden
}

const { days } = Astro.props;

const [tomorrow, ...laterDays] = days;

// Helper: nombre corto del día "Mié 23"
const shortLabel = (day: FeriaDay) => {
  const d = new Date(day.date + "T12:00:00");
  const wd = d.toLocaleDateString("es-HN", { weekday: "short" });
  const wdCap = wd.charAt(0).toUpperCase() + wd.slice(1).replace(".", "");
  return `${wdCap} ${day.dayNumber}`;
};

// Full day name for tomorrow
const tomorrowFull = (day: FeriaDay) => {
  const d = new Date(day.date + "T12:00:00");
  const wd = d.toLocaleDateString("es-HN", { weekday: "long" });
  return wd.charAt(0).toUpperCase() + wd.slice(1);
};
---

{days.length > 0 && (
  <section id="proximo" class="upcoming-section" aria-label="Próximas actividades" style="scroll-margin-top: 56px;">
    <div class="container">

      <!-- Header -->
      <div class="upcoming-header">
        <p class="section-eyebrow upcoming-eyebrow">¿Qué viene después?</p>
      </div>

      <!-- ── Mañana (expandido) ─────────────────────── -->
      {tomorrow && (
        <div class="tomorrow-block">
          <h2 class="tomorrow-title">
            <span class="tomorrow-label">Mañana</span>
            <span class="tomorrow-day">— {tomorrowFull(tomorrow)} {tomorrow.dayNumber}</span>
          </h2>
          <div role="list" aria-label={`Actividades del ${tomorrowFull(tomorrow)} ${tomorrow.dayNumber}`}>
            {tomorrow.activities.map((act) => (
              <div role="listitem">
                <ActivityRow activity={act} compact={true} />
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- ── Días siguientes ────────────────────────── -->
      {laterDays.length > 0 && (
        <div class="later-section">
          {laterDays.map((day) => (
            <details class="later-day">
              <summary class="later-day-summary" aria-label={`${shortLabel(day)}: ${day.activities.length} actividades`}>
                <span class="later-day-name">{shortLabel(day)}</span>
                <span class="later-day-count">{day.activities.length} actividades</span>
                <svg class="later-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
              </summary>

              <div class="later-day-activities" role="list">
                {day.activities.map((act) => (
                  <div role="listitem">
                    <ActivityRow activity={act} compact={true} />
                  </div>
                ))}
              </div>
            </details>
          ))}
        </div>
      )}

    </div>
  </section>
)}

<style>
  .upcoming-section {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding-block: 3rem 3.5rem;
  }

  /* ─── Header ──────────────────────────────────────── */
  .upcoming-header {
    margin-bottom: 1.5rem;
  }

  .upcoming-eyebrow {
    color: var(--color-muted);
    margin: 0;
  }

  /* ─── Mañana ──────────────────────────────────────── */
  .tomorrow-block {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .tomorrow-title {
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 5vw, 1.75rem);
    font-weight: 800;
    color: var(--color-ink);
    margin: 0 0 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
  }

  .tomorrow-label {
    color: var(--color-ink);
    font-weight: 800;
  }

  .tomorrow-day {
    font-size: 0.8em;
    font-weight: 500;
    color: var(--color-muted);
    font-style: normal;
    letter-spacing: 0;
  }

  /* ─── Días siguientes ─────────────────────────────── */
  .later-section {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* details nativo */
  .later-day {
    border-top: 1px solid var(--color-border);
  }

  .later-day:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .later-day-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 0;
    cursor: pointer;
    list-style: none;
    min-height: 48px;
    user-select: none;

    &::-webkit-details-marker { display: none; }
    &::marker { display: none; }
  }

  .later-day-summary:hover .later-day-name {
    color: var(--color-accent);
  }

  .later-day-name {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-ink);
    flex: 1;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }

  .later-day-count {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .later-chevron {
    width: 1rem;
    height: 1rem;
    color: var(--color-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.15s ease;
  }

  .later-day-summary:hover .later-chevron {
    color: var(--color-ink);
  }

  details[open] .later-chevron {
    transform: rotate(180deg);
  }

  .later-day-activities {
    padding-bottom: 0.75rem;
  }
</style>
