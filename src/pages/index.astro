---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeriaHeader from "../components/FeriaHeader.astro";
import TodaySection from "../components/TodaySection.astro";
import UpcomingSection from "../components/UpcomingSection.astro";
import ExploreSection from "../components/ExploreSection.astro";
import { feria } from "../data/feria";

// ─── Determine current feria day ─────────────────────────────────────────────
// We compare today's date against the feria days.
// If outside the feria window, we show the first day (for demo purposes).

const todayISO = new Date().toISOString().split("T")[0]; // "YYYY-MM-DD"

// Find today's index in the feria schedule
let todayIndex = feria.days.findIndex((d) => d.date === todayISO);

// Prototype fallback: if today is not in the feria window,
// use the day hardcoded as "martes 22" (index 2) to demonstrate the design.
if (todayIndex === -1) {
  todayIndex = 2; // Martes 22 = the featured day in our prototype
}

const todayDay = feria.days[todayIndex];
const upcomingDays = feria.days.slice(todayIndex + 1);
const currentDayNumber = todayIndex + 1; // 1-based

// ─── Page metadata ────────────────────────────────────────────────────────────
const pageTitle = `${todayDay.dayLabel} · Feria Patronal de San Marcos 2026`;
const pageDescription = `Programa de actividades del ${todayDay.dayLabel} en la Feria Patronal de San Marcos de la Sierra 2026. Consulta todo lo que hay hoy y los próximos días.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>

  <!-- ① Sticky compact header -->
  <FeriaHeader
    feriaName={feria.name}
    town={feria.town}
    startDate={feria.startDate}
    endDate={feria.endDate}
    currentDayNumber={currentDayNumber}
    totalDays={feria.totalDays}
  />

  <main id="main-content">

    <!-- ② + ③ Today's day and activities — THE HERO -->
    <TodaySection
      day={todayDay}
      dayIndex={todayIndex}
      totalDays={feria.totalDays}
    />

    <!-- ④ + ⑤ Upcoming days -->
    <UpcomingSection days={upcomingDays} />

    <!-- ⑥ Explore the town -->
    <ExploreSection />

  </main>

  <!-- Skip-to-content link (accessibility) -->
  <a href="#main-content" class="skip-link">Ir al contenido principal</a>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="page-container">
      <p class="footer-text">
        Feria Patronal de San Marcos 2026 · San Marcos de la Sierra, Honduras
      </p>
      <p class="footer-patron">
        En honor a San Marcos Evangelista
      </p>
    </div>
  </footer>

</BaseLayout>

<style>
  /* Skip link — visible only on focus */
  .skip-link {
    position: absolute;
    top: -999px;
    left: 1rem;
    background: var(--color-accent);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 0 0 0.5rem 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    z-index: 100;
  }

  .skip-link:focus {
    top: 0;
  }

  /* Footer */
  .site-footer {
    background-color: var(--color-text);
    padding-block: 1.5rem;
  }

  .site-footer .page-container {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: center;
    text-align: center;
  }

  .footer-text {
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.6);
    margin: 0;
  }

  .footer-patron {
    font-size: 0.6875rem;
    color: rgb(255 255 255 / 0.4);
    margin: 0;
    font-style: italic;
  }
</style>
