---
// FullScheduleModal.astro — Bottom Sheet (Mobile) / Modal Centrado (Desktop)
// Acordeón rápido y compacto de los 7 días de la feria.
// Fuente única de datos: feria.days
import type { FeriaDay } from "../data/feria";

interface Props {
  days: FeriaDay[];
  initialDayIndex: number;
}

const { days, initialDayIndex } = Astro.props;

// Helper: formato de nombre del día "Lun 5"
const formatDayName = (day: FeriaDay) => {
  const d = new Date(day.date + "T12:00:00");
  const wd = d.toLocaleDateString("es-HN", { weekday: "short" });
  const wdCap = wd.charAt(0).toUpperCase() + wd.slice(1).replace(".", "");
  return `${wdCap} ${day.dayNumber}`;
};

const formatDayFull = (day: FeriaDay) => {
  const d = new Date(day.date + "T12:00:00");
  const wd = d.toLocaleDateString("es-HN", { weekday: "long", day: "numeric", month: "long" });
  return wd.charAt(0).toUpperCase() + wd.slice(1);
};
---

<!-- Backdrop y contenedor del modal -->
<div
  id="schedule-modal-backdrop"
  class="schedule-backdrop"
  aria-hidden="true"
>
  <div
    id="schedule-modal"
    class="schedule-sheet"
    role="dialog"
    aria-modal="true"
    aria-labelledby="schedule-modal-title"
    tabindex="-1"
  >
    <!-- Barra superior para mobile (drag handle visual) -->
    <div class="sheet-handle-bar" aria-hidden="true">
      <div class="sheet-drag-pill"></div>
    </div>

    <!-- Encabezado del modal -->
    <header class="sheet-header">
      <div class="sheet-header-text">
        <h2 id="schedule-modal-title" class="sheet-title">Programa completo</h2>
        <p class="sheet-subtitle">{days.length} días de actividades</p>
      </div>
      <button
        type="button"
        id="schedule-modal-close"
        class="sheet-close-btn"
        aria-label="Cerrar programa completo"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="close-icon" aria-hidden="true">
          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
        </svg>
      </button>
    </header>

    <!-- Contenido scrollable: Acordeón de días -->
    <div class="sheet-body" id="sheet-body">
      <div class="schedule-accordion" role="region" aria-label="Días de la feria">
        {days.map((day, i) => {
          const isInitialToday = i === initialDayIndex;
          const dayTitle = formatDayName(day);
          const fullLabel = formatDayFull(day);
          return (
            <details
              class:list={["schedule-day", { "is-today": isInitialToday }]}
              id={`schedule-day-${i}`}
              data-day-index={i}
              data-day-date={day.date}
              open={isInitialToday}
            >
              <summary
                class="schedule-day-summary"
                aria-label={`${fullLabel}: ${day.activities.length} actividades`}
              >
                <div class="summary-left">
                  <span class="day-short-name">{dayTitle}</span>
                  <span class="day-today-tag" data-today-indicator style={isInitialToday ? "" : "display: none;"}>
                    HOY
                  </span>
                </div>
                <div class="summary-right">
                  <span class="day-count">{day.activities.length} actividades</span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="chevron-icon" aria-hidden="true">
                    <path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                  </svg>
                </div>
              </summary>

              <!-- Lista compacta de actividades para consulta rápida (sin fotos) -->
              <div class="schedule-day-content" role="list">
                {day.activities.map((act) => (
                  <div class="schedule-act-row" role="listitem">
                    <span class="act-time">{act.time}</span>
                    <div class="act-info">
                      <p class="act-title">{act.title}</p>
                      <p class="act-loc">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="act-loc-icon" aria-hidden="true">
                          <path fill-rule="evenodd" d="M8 1.5A4.5 4.5 0 0 0 3.5 6c0 2.29 1.7 4.716 4.5 7.5C10.8 10.716 12.5 8.29 12.5 6A4.5 4.5 0 0 0 8 1.5ZM8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z" clip-rule="evenodd"/>
                        </svg>
                        <span>{act.location}</span>
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </details>
          );
        })}
      </div>
    </div>
  </div>
</div>

<script define:vars={{ initialDayIndex, daysCount: days.length }}>
  // ─── Lógica del Modal / Bottom Sheet ───────────────────────────────────────
  const backdrop  = document.getElementById("schedule-modal-backdrop");
  const modal     = document.getElementById("schedule-modal");
  const closeBtn  = document.getElementById("schedule-modal-close");
  const sheetBody = document.getElementById("sheet-body");
  const dayItems  = Array.from(document.querySelectorAll(".schedule-day"));

  // Detectar el día actual real del dispositivo
  const todayISO = new Date().toISOString().split("T")[0];
  let actualTodayIdx = -1;
  dayItems.forEach((el, idx) => {
    if (el.dataset.dayDate === todayISO) {
      actualTodayIdx = idx;
    }
  });

  // Si no coincide con las fechas de la feria, usar el fallback del servidor
  const activeTodayIdx = actualTodayIdx !== -1 ? actualTodayIdx : initialDayIndex;

  // Actualizar indicadores visuales de "HOY" y abrirlo por defecto
  function syncTodayAccordion() {
    dayItems.forEach((el, idx) => {
      const isToday = idx === activeTodayIdx;
      const tag = el.querySelector("[data-today-indicator]");
      if (tag) {
        tag.style.display = isToday ? "inline-flex" : "none";
      }
      el.classList.toggle("is-today", isToday);
      // Abrir HOY por defecto, los demás colapsados
      el.open = isToday;
    });
  }

  syncTodayAccordion();

  // Abrir Modal
  function openModal() {
    backdrop.classList.add("is-visible");
    modal.classList.add("is-visible");
    backdrop.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";

    // Auto-scroll al día actual para conveniencia del usuario
    const todayEl = document.getElementById(`schedule-day-${activeTodayIdx}`);
    if (todayEl) {
      setTimeout(() => {
        todayEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }, 100);
    }
  }

  // Cerrar Modal
  function closeModal() {
    modal.classList.remove("is-visible");
    backdrop.classList.remove("is-visible");
    backdrop.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  // Listeners de cierre
  closeBtn.addEventListener("click", closeModal);

  backdrop.addEventListener("click", (e) => {
    if (e.target === backdrop) {
      closeModal();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && backdrop.classList.contains("is-visible")) {
      closeModal();
    }
  });

  // Conectar todos los elementos con [data-open-schedule]
  function bindTriggers() {
    const triggers = document.querySelectorAll("[data-open-schedule]");
    triggers.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        openModal();
      });
    });
  }

  bindTriggers();

  // Exponer a window para llamadas globales
  window.openFullSchedule = openModal;
  window.closeFullSchedule = closeModal;
</script>

<style>
  /* ─── Backdrop ─────────────────────────────────────── */
  .schedule-backdrop {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    display: flex;
    align-items: flex-end;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.24s var(--ease-out);
  }

  .schedule-backdrop.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* ─── Sheet (Mobile: Bottom Sheet 85-90% altura) ───── */
  .schedule-sheet {
    width: 100%;
    max-height: 88vh;
    height: 88vh;
    background: #FFFFFF;
    border-radius: 18px 18px 0 0;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    transform: translateY(100%);
    transition: transform 0.28s var(--ease-out);
    overflow: hidden;
  }

  .schedule-sheet.is-visible {
    transform: translateY(0);
  }

  /* Handle bar superior en mobile */
  .sheet-handle-bar {
    padding-top: 10px;
    padding-bottom: 4px;
    display: flex;
    justify-content: center;
    background: #FFFFFF;
    cursor: grab;
  }

  .sheet-drag-pill {
    width: 36px;
    height: 4px;
    border-radius: 999px;
    background: #D1D5DB;
  }

  /* ─── Encabezado ───────────────────────────────────── */
  .sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem 1rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
    background: #FFFFFF;
  }

  .sheet-title {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .sheet-subtitle {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
    margin: 0.15rem 0 0;
  }

  .sheet-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #F3F4F6;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .sheet-close-btn:hover {
    background: #E5E7EB;
    color: var(--color-accent);
  }

  .close-icon {
    width: 20px;
    height: 20px;
  }

  /* ─── Cuerpo con scroll ────────────────────────────── */
  .sheet-body {
    flex: 1;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.25rem 0 2rem;
  }

  /* ─── Acordeón ─────────────────────────────────────── */
  .schedule-accordion {
    display: flex;
    flex-direction: column;
  }

  .schedule-day {
    border-bottom: 1px solid var(--color-border);
  }

  .schedule-day-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 1.25rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    min-height: 52px;
    transition: background-color 0.12s ease;

    &::-webkit-details-marker { display: none; }
    &::marker { display: none; }
  }

  .schedule-day-summary:hover {
    background-color: #F9FAFB;
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .day-short-name {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  /* Badge SUTIL "HOY" */
  .day-today-tag {
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(240, 90, 22, 0.12);
    padding: 0.15em 0.5em;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
  }

  .summary-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .day-count {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .chevron-icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-muted);
    transition: transform 0.2s ease, color 0.15s ease;
    flex-shrink: 0;
  }

  .schedule-day[open] .chevron-icon {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  /* ─── Lista de actividades (compacta y rápida) ─────── */
  .schedule-day-content {
    background: #F8F9FA;
    padding: 0.5rem 1.25rem 0.875rem;
    border-top: 1px solid var(--color-border);
  }

  .schedule-act-row {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    padding: 0.65rem 0;
  }

  .schedule-act-row + .schedule-act-row {
    border-top: 1px solid #E5E7EB;
  }

  .act-time {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
    white-space: nowrap;
    width: 4.25rem;
    text-align: right;
    flex-shrink: 0;
  }

  .act-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .act-title {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
    margin: 0;
  }

  .act-loc {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-muted);
    margin: 0;
  }

  .act-loc-icon {
    width: 0.6875rem;
    height: 0.6875rem;
    flex-shrink: 0;
    opacity: 0.6;
  }

  /* ─── Desktop (>= 640px): Modal Centrado ───────────── */
  @media (min-width: 640px) {
    .schedule-backdrop {
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .sheet-handle-bar {
      display: none;
    }

    .schedule-sheet {
      width: 100%;
      max-width: 580px;
      height: auto;
      max-height: 82vh;
      border-radius: 16px;
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.2);
      transform: scale(0.95);
      transition: transform 0.2s var(--ease-out);
    }

    .schedule-sheet.is-visible {
      transform: scale(1);
    }

    .sheet-header {
      padding: 1.125rem 1.5rem;
    }

    .sheet-title {
      font-size: 1.25rem;
    }

    .sheet-body {
      padding: 0.25rem 0 1.5rem;
    }

    .schedule-day-summary {
      padding: 1rem 1.5rem;
    }

    .schedule-day-content {
      padding: 0.65rem 1.5rem 1rem;
    }
  }
</style>
