---
// FeriaHeader.astro
// Ultra-compact top bar: feria identity + navigation entry
interface Props {
  feriaName: string;
  town: string;
  startDate: string;
  endDate: string;
  currentDayNumber: number; // e.g. 3
  totalDays: number;        // e.g. 7
}

const { feriaName, town, startDate, endDate, currentDayNumber, totalDays } = Astro.props;

// Format date range: "20 – 26 sep"
const fmt = (iso: string) => {
  const d = new Date(iso + "T12:00:00");
  return d.toLocaleDateString("es-HN", { day: "numeric", month: "short" });
};
const dateRange = `${fmt(startDate)} – ${fmt(endDate)}`;
---

<header class="feria-header">
  <div class="page-container header-inner">
    <!-- Left: Feria name + dates -->
    <div class="header-identity">
      <span class="feria-name">{feriaName}</span>
      <span class="header-dates">{town} · {dateRange}</span>
    </div>

    <!-- Right: Day counter pill -->
    <div class="day-counter" aria-label={`Día ${currentDayNumber} de ${totalDays}`}>
      <span class="day-counter-number">{currentDayNumber}</span>
      <span class="day-counter-of">/{totalDays}</span>
    </div>
  </div>
</header>

<style>
  .feria-header {
    background-color: var(--color-accent);
    color: white;
    position: sticky;
    top: 0;
    z-index: 50;
    /* Subtle shadow to separate from content */
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.75rem;
    /* Override page-container inline padding for this element */
    padding-inline: 1rem;
  }

  .header-identity {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0; /* allow text-overflow to work */
  }

  .feria-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    color: white;
    /* Prevent long names from breaking layout */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .header-dates {
    font-size: 0.6875rem;
    font-weight: 500;
    color: rgb(255 255 255 / 0.8);
    white-space: nowrap;
  }

  /* Day counter: circular badge showing "3/7" */
  .day-counter {
    flex-shrink: 0;
    display: flex;
    align-items: baseline;
    gap: 0.05rem;
    background: rgb(255 255 255 / 0.18);
    border: 1.5px solid rgb(255 255 255 / 0.35);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    line-height: 1;
  }

  .day-counter-number {
    font-size: 1.125rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: white;
  }

  .day-counter-of {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.75);
  }
</style>
