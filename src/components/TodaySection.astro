    font-family: var(--font-display);
    font-size: clamp(1.25rem, 4.5vw, 1.625rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-dark);
    margin: 0 0 0.45rem;
  }

  .featured-location {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted-dark);
    margin: 0;
  }

  .loc-icon {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    opacity: 0.55;
  }

  /* ─── Featured: editorial (sin foto) ────────────── */
  .featured-card--editorial {
    background: var(--color-ink-mid);
    display: flex;
    align-items: stretch;
    min-height: 148px;
  }

  .featured-editorial-time {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 3.5vw, 1.125rem);
    font-weight: 800;
    font-style: italic;
    color: var(--color-fire);
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    padding: 1rem 0.875rem;
    background: var(--color-ink);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .featured-editorial-body {
    flex: 1;
    padding: 1.125rem 1.125rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
  }

  .featured-editorial-cat {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted-light);
    margin: 0;
  }

  .featured-editorial-title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 4.5vw, 1.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-light);
    margin: 0;
  }

  .featured-editorial-loc {
    color: rgb(245 240 232 / 0.55);
  }

  .featured-editorial-loc .loc-icon {
    color: rgb(245 240 232 / 0.55);
  }

  /* ─── Lista secundaria ───────────────────────────── */
  .secondary-activities {
    margin-top: 0.375rem;
    border-top: 1px solid var(--color-border-light);
  }

  .secondary-row {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border-light);
    min-height: 44px;
  }

  .secondary-time {
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-fire);
    white-space: nowrap;
    flex-shrink: 0;
    width: 4.5rem;
    text-align: right;
  }

  .secondary-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .secondary-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-dark);
    line-height: 1.3;
  }

  .secondary-loc {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-text-muted-dark);
    line-height: 1.4;
  }

  .loc-icon-sm {
    width: 0.6875rem;
    height: 0.6875rem;
    flex-shrink: 0;
    opacity: 0.45;
  }

  /* ─── "Ver programa completo" ────────────────────── */
  .see-all-wrap {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-light);
    margin-top: 0;
  }

  .see-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted-dark);
    text-decoration: none;
    transition: color 0.15s ease;
    min-height: 36px;
    padding: 0.25rem 0;
  }

  .see-all-link:hover {
    color: var(--color-fire);
  }

  .see-all-icon {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
  }

  /* ─── Responsive ─────────────────────────────────── */
  @media (min-width: 640px) {
    .today-section {
      padding-bottom: 3.5rem;
    }

    .featured-title {
      font-size: 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    /* En desktop, el panel de hoy puede ir a 2 columnas:
       featured (izq) + lista secundaria (der) */
    .day-panel {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto;
      gap: 0 2rem;
      align-items: start;
    }

    .today-header {
      grid-column: 1 / -1;
    }

    .featured-wrap {
      grid-column: 1;
    }

    .secondary-activities {
      grid-column: 2;
      margin-top: 0;
      border-top: none;
    }

    .see-all-wrap {
      grid-column: 1 / -1;
    }
  }
</style>
