---
// PuebloSection.astro — Descubre el pueblo
// Cards fotográficas con scroll horizontal en mobile para cada categoría
import {
  restaurants, cafes, hotels, landmarks,
  type Place,
} from "../data/feria";

interface Category {
  id:     string;
  icon:   string;
  label:  string;
  places: Place[];
  fullWidth?: boolean; // landmarks se muestra en cards verticales más grandes
}

const categories: Category[] = [
  { id: "comer",     icon: "🍽️", label: "Dónde comer",       places: restaurants },
  { id: "cafes",     icon: "☕",  label: "Cafeterías",          places: cafes       },
  { id: "hospedaje", icon: "🛏️", label: "Hospedaje",           places: hotels      },
  { id: "lugares",   icon: "📍",  label: "Lugares de interés",  places: landmarks, fullWidth: true },
];
---

<section id="pueblo" class="pueblo-section" aria-label="Descubre el pueblo">

  <!-- ── Section intro (dark background, editorial) ─ -->
  <div class="pueblo-intro">
    <div class="container">
      <p class="section-eyebrow pueblo-eyebrow">¿Dónde puedo ir?</p>
      <h2 class="pueblo-title">
        Descubre<br/>el pueblo
      </h2>
      <p class="pueblo-subtitle">
        Todo lo que necesitas a mano durante la feria.
      </p>
    </div>
  </div>

  <!-- ── Categories ─────────────────────────────────── -->
  <div class="pueblo-categories">
    {categories.map((cat) => (
      <div class="category-section" id={cat.id}>

        <!-- Category label row -->
        <div class="container">
          <div class="category-header">
            <span class="category-icon" aria-hidden="true">{cat.icon}</span>
            <h3 class="category-title">{cat.label}</h3>
          </div>
        </div>

        {cat.fullWidth ? (
          <div class="container landmarks-list">
            {cat.places.map((place) => (
              <article class="landmark-card">
                <div class="landmark-img-wrap">
                  <img
                    src={place.image}
                    alt={place.name}
                    class="landmark-img"
                    loading="lazy"
                    width="800"
                    height="534"
                  />
                </div>
                <div class="landmark-body">
                  <div class="landmark-header">
                    <h4 class="landmark-name">{place.name}</h4>
                    <span class="landmark-tagline">{place.tagline}</span>
                  </div>
                  <p class="landmark-description">{place.description}</p>
                  <a
                    href={place.mapsUrl ?? "#"}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="place-map-link"
                    aria-label={`Ver ubicación de ${place.name} en mapa`}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="map-link-icon" aria-hidden="true">
                      <path fill-rule="evenodd" d="M8 1.5A4.5 4.5 0 0 0 3.5 6c0 2.29 1.7 4.716 4.5 7.5C10.8 10.716 12.5 8.29 12.5 6A4.5 4.5 0 0 0 8 1.5ZM8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z" clip-rule="evenodd" />
                    </svg>
                    {place.address}
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="scroll-track-wrapper">
            <ul
              class="scroll-track"
              role="list"
              aria-label={`Lista de ${cat.label}`}
            >
              {cat.places.map((place) => (
                <li class="place-card-wrap" role="listitem">
                  <article class="place-card">
                    <div class="place-card-img-wrap">
                      <img
                        src={place.image}
                        alt={place.name}
                        class="place-card-img"
                        loading="lazy"
                        width="600"
                        height="400"
                      />
                    </div>
                    <div class="place-card-body">
                      <h4 class="place-card-name">{place.name}</h4>
                      <p class="place-card-tagline">{place.tagline}</p>
                      <p class="place-card-desc">{place.description}</p>
                      <div class="place-card-footer">
                        {place.hours && (
                          <span class="place-hours">{place.hours}</span>
                        )}
                        <a
                          href={place.mapsUrl ?? "#"}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="place-map-link"
                          aria-label={`Ver ${place.name} en el mapa`}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="map-link-icon" aria-hidden="true">
                            <path fill-rule="evenodd" d="M8 1.5A4.5 4.5 0 0 0 3.5 6c0 2.29 1.7 4.716 4.5 7.5C10.8 10.716 12.5 8.29 12.5 6A4.5 4.5 0 0 0 8 1.5ZM8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z" clip-rule="evenodd" />
                          </svg>
                          {place.address}
                        </a>
                      </div>
                    </div>
                  </article>
                </li>
              ))}
            </ul>
          </div>
        )}

      </div>
    ))}
  </div>

</section>

<style>
  /* ─── Intro block (dark) ─────────────────────────── */
  .pueblo-section {
    background-color: var(--color-cream);
  }

  .pueblo-intro {
    background-color: var(--color-ink-mid);
    padding-block: 3rem 2.5rem;
  }

  .pueblo-eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted-light);
    margin: 0 0 0.5rem;
  }

  .pueblo-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 9vw, 3.75rem);
    font-weight: 800;
    font-style: italic;
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: var(--color-text-light);
    margin: 0 0 0.875rem;
  }

  .pueblo-subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-muted-light);
    margin: 0;
    max-width: 34ch;
    line-height: 1.55;
  }

  /* ─── Categories container ───────────────────────── */
  .pueblo-categories {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ─── Category section ───────────────────────────── */
  .category-section {
    padding-top: 2rem;
    padding-bottom: 1.5rem;
    border-top: 1px solid var(--color-border-light);
  }

  .category-section:first-child {
    border-top: none;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .category-icon {
    font-size: 1.125rem;
    line-height: 1;
  }

  .category-title {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted-dark);
    margin: 0;
  }

  /* ─── Horizontal scroll track ────────────────────── */
  .scroll-track-wrapper {
    /* Full-bleed so cards can scroll edge-to-edge */
    overflow: hidden;
  }

  .scroll-track {
    display: flex;
    gap: 0.875rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* hide on Firefox */
    padding-inline: var(--page-px, 1.25rem);
    padding-bottom: 0.5rem;
    list-style: none;
    margin: 0;
    /* Leading/trailing edge padding trick for the last card */
    padding-right: calc(var(--page-px, 1.25rem) + 1rem);
  }

  .scroll-track::-webkit-scrollbar {
    display: none;
  }

  .place-card-wrap {
    flex: 0 0 clamp(240px, 72vw, 300px);
    scroll-snap-align: start;
  }

  /* ─── Place card ─────────────────────────────────── */
  .place-card {
    background: #fff;
    border-radius: 10px;
    border: 1px solid var(--color-border-light);
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .place-card-img-wrap {
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .place-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: scale 0.4s ease;
  }

  .place-card:hover .place-card-img {
    scale: 1.04;
  }

  .place-card-body {
    padding: 0.875rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .place-card-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-dark);
    margin: 0;
    line-height: 1.25;
  }

  .place-card-tagline {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-fire);
    margin: 0;
    letter-spacing: 0.01em;
  }

  .place-card-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted-dark);
    margin: 0.25rem 0 0;
    line-height: 1.5;
    flex: 1;
  }

  .place-card-footer {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .place-hours {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted-dark);
  }

  /* ─── Map link ───────────────────────────────────── */
  .place-map-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-fire);
    text-decoration: none;
    transition: color 0.15s ease;
    min-height: 36px;
    padding: 0;
  }

  .place-map-link:hover {
    color: var(--color-fire-light);
    text-decoration: underline;
  }

  .map-link-icon {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
  }

  /* ─── Landmark cards (full width, stacked) ────────── */
  .landmarks-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .landmark-card {
    background: #fff;
    border-radius: 10px;
    border: 1px solid var(--color-border-light);
    overflow: hidden;
  }

  .landmark-img-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .landmark-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: scale 0.4s ease;
  }

  .landmark-card:hover .landmark-img {
    scale: 1.03;
  }

  .landmark-body {
    padding: 1rem 1.125rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .landmark-header {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .landmark-name {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 800;
    color: var(--color-text-dark);
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .landmark-tagline {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-fire);
    letter-spacing: 0.01em;
  }

  .landmark-description {
    font-size: 0.875rem;
    color: var(--color-text-muted-dark);
    margin: 0.1rem 0 0.25rem;
    line-height: 1.55;
  }

  /* ─── Desktop: 2-column grid for landmarks ───────── */
  @media (min-width: 640px) {
    .landmarks-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }

    .place-card-wrap {
      flex: 0 0 clamp(260px, 42vw, 340px);
    }
  }

  @media (min-width: 1024px) {
    .scroll-track {
      /* On desktop, show all cards without scroll */
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      overflow-x: visible;
      scroll-snap-type: none;
    }

    .place-card-wrap {
      flex: none;
    }
  }
</style>
