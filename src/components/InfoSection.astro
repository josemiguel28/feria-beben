---
// InfoSection.astro — Información práctica (fondo oscuro)
---

<section id="info" class="info-section section-dark" aria-label="Información práctica">
  <div class="container">

    <!-- Header -->
    <div class="info-header">
      <p class="section-eyebrow info-eyebrow">¿Qué necesito saber?</p>
      <h2 class="info-title display-md">
        Lo que<br/>necesitas saber
      </h2>
    </div>

    <!-- Info blocks -->
    <div class="info-grid">

      <!-- Puntos de referencia -->
      <div class="info-block">
        <div class="info-block-header">
          <span class="info-icon" aria-hidden="true">📍</span>
          <h3 class="info-block-title">Puntos de referencia</h3>
        </div>
        <ul class="info-list">
          <li class="info-list-item">
            <span class="info-list-name">Plaza Municipal</span>
            <span class="info-list-detail">Centro del pueblo, actividades principales</span>
          </li>
          <li class="info-list-item">
            <span class="info-list-name">Parque Central</span>
            <span class="info-list-detail">Desfiles, carrozas y eventos al aire libre</span>
          </li>
          <li class="info-list-item">
            <span class="info-list-name">Iglesia San Marcos</span>
            <span class="info-list-detail">Misas y actividades religiosas</span>
          </li>
          <li class="info-list-item">
            <span class="info-list-name">Campo Deportivo</span>
            <span class="info-list-detail">Torneos y competencias deportivas</span>
          </li>
        </ul>
      </div>

      <hr class="section-divider section-divider--dark" />

      <!-- Horarios generales -->
      <div class="info-block">
        <div class="info-block-header">
          <span class="info-icon" aria-hidden="true">🕐</span>
          <h3 class="info-block-title">Horarios generales</h3>
        </div>
        <ul class="info-list">
          <li class="info-list-item">
            <span class="info-list-name">Actividades diurnas</span>
            <span class="info-list-detail">9:00 AM – 6:00 PM</span>
          </li>
          <li class="info-list-item">
            <span class="info-list-name">Actividades nocturnas</span>
            <span class="info-list-detail">7:00 PM – 11:00 PM</span>
          </li>
          <li class="info-list-item">
            <span class="info-list-name">Misas patronales</span>
            <span class="info-list-detail">Ver programa diario</span>
          </li>
        </ul>
      </div>

      <hr class="section-divider section-divider--dark" />

      <!-- Contacto -->
      <div class="info-block">
        <div class="info-block-header">
          <span class="info-icon" aria-hidden="true">📞</span>
          <h3 class="info-block-title">Contacto</h3>
        </div>
        <ul class="info-list">
          <li class="info-list-item">
            <span class="info-list-name">Alcaldía Municipal</span>
            <span class="info-list-detail">
              <a href="tel:+50499999999" class="info-link">+504 9999-9999</a>
            </span>
          </li>
          <li class="info-list-item">
            <span class="info-list-name">Comité de Feria</span>
            <span class="info-list-detail">
              <a href="tel:+50488888888" class="info-link">+504 8888-8888</a>
            </span>
          </li>
        </ul>
      </div>

      <hr class="section-divider section-divider--dark" />

      <!-- Cómo llegar -->
      <div class="info-block">
        <div class="info-block-header">
          <span class="info-icon" aria-hidden="true">🗺️</span>
          <h3 class="info-block-title">Cómo llegar</h3>
        </div>
        <p class="info-text">
          San Marcos de la Sierra está ubicado en el departamento de Intibucá, Honduras.
          Acceso por carretera desde La Esperanza (aprox. 35 km).
        </p>
        <a
          href="https://maps.google.com?q=San+Marcos+de+la+Sierra+Honduras"
          target="_blank"
          rel="noopener noreferrer"
          class="info-map-btn"
          aria-label="Ver San Marcos de la Sierra en Google Maps (abre en nueva pestaña)"
        >
          <svg class="info-map-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M8 1.5A4.5 4.5 0 0 0 3.5 6c0 2.29 1.7 4.716 4.5 7.5C10.8 10.716 12.5 8.29 12.5 6A4.5 4.5 0 0 0 8 1.5ZM8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z" clip-rule="evenodd" />
          </svg>
          Ver en Google Maps
          <svg class="info-ext-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
            <path d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .info-section {
    padding-block: 3rem 3.5rem;
  }

  /* ─── Header ──────────────────────────────────────── */
  .info-header {
    margin-bottom: 2rem;
  }

  .info-eyebrow {
    color: var(--color-text-muted-light);
    margin: 0 0 0.5rem;
  }

  .info-title {
    color: var(--color-text-light);
    margin: 0;
    font-style: italic;
  }

  /* ─── Grid ────────────────────────────────────────── */
  .info-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ─── Info block ──────────────────────────────────── */
  .info-block {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .info-block-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .info-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .info-block-title {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted-light);
    margin: 0;
  }

  /* ─── Info list ───────────────────────────────────── */
  .info-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .info-list-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.625rem 0;
  }

  .info-list-item + .info-list-item {
    border-top: 1px solid var(--color-border-dark);
  }

  .info-list-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-light);
    line-height: 1.3;
  }

  .info-list-detail {
    font-size: 0.8125rem;
    color: var(--color-text-muted-light);
    line-height: 1.4;
  }

  /* ─── Links ───────────────────────────────────────── */
  .info-link {
    color: var(--color-fire-light);
    text-decoration: none;
    font-weight: 600;
  }

  .info-link:hover {
    text-decoration: underline;
  }

  .info-text {
    font-size: 0.9375rem;
    color: var(--color-text-muted-light);
    margin: 0;
    line-height: 1.6;
  }

  .info-map-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gold);
    text-decoration: none;
    padding: 0.625rem 0;
    min-height: 44px;
    transition: color 0.15s ease;
  }

  .info-map-btn:hover {
    color: var(--color-gold-dim);
  }

  .info-map-icon,
  .info-ext-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
  }

  .info-ext-icon {
    opacity: 0.7;
    margin-left: 0.125rem;
  }
</style>
