---
// ActivityCard.astro
// Single activity row with time, title, location, and category pill
import type { Activity } from "../data/feria";
import { categoryColors } from "../data/feria";

interface Props {
  activity: Activity;
  variant?: "today" | "upcoming"; // upcoming = more compact
  animationClass?: string; // e.g. "reveal reveal-2"
}

const { activity, variant = "today", animationClass = "" } = Astro.props;
const { bg, text, label } = categoryColors[activity.category];
---

{variant === "today" ? (
  <div class={`activity-card ${animationClass}`} role="listitem">
    <!-- Time column -->
    <div class="activity-time" aria-label={`Hora: ${activity.time}`}>
      <span class="time-badge">{activity.time}</span>
    </div>

    <!-- Content column -->
    <div class="activity-content">
      <p class="activity-title">{activity.title}</p>
      <p class="activity-location">
        <svg class="location-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M8 1.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9ZM2.5 6a5.5 5.5 0 1 1 9.384 3.89L14.95 13h-1.414l-3.067-3.11A5.5 5.5 0 0 1 2.5 6Z" clip-rule="evenodd" />
        </svg>
        <span>{activity.location}</span>
      </p>
    </div>

    <!-- Category pill -->
    <div class={`pill ${bg} ${text}`} aria-label={`Categoría: ${label}`}>
      {label}
    </div>
  </div>
) : (
  <div class={`activity-card activity-card--compact ${animationClass}`} role="listitem">
    <span class="time-badge">{activity.time}</span>
    <span class="activity-title activity-title--compact">{activity.title}</span>
  </div>
)}

<style>
  /* ─── Full variant (today) ──────────────────── */
  .activity-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    min-height: 44px; /* touch target */
  }

  .activity-card + .activity-card {
    border-top: 1px solid var(--color-border);
  }

  .activity-time {
    flex-shrink: 0;
    width: 4.5rem;
    padding-top: 0.125rem;
    text-align: right;
  }

  .activity-content {
    flex: 1;
    min-width: 0;
  }

  .activity-title {
    font-size: 0.9375rem; /* 15px */
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text);
    margin: 0;
  }

  .activity-location {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0.2rem 0 0;
    line-height: 1.4;
  }

  .location-icon {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    color: var(--color-text-subtle);
  }

  /* ─── Compact variant (upcoming) ───────────── */
  .activity-card--compact {
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0;
  }

  .activity-card--compact + .activity-card--compact {
    border-top: 1px solid var(--color-border);
  }

  .activity-title--compact {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
