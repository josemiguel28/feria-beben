---
// HeroSection.astro — Hero fotográfico de la feria
interface Props {
  feriaName: string;
  town: string;
  year: number;
  startDate: string;
  endDate: string;
  currentDayNumber: number;
  totalDays: number;
  isActive: boolean; // ¿La feria está activa ahora mismo?
}

const {
  feriaName,
  town,
  year,
  startDate,
  endDate,
  currentDayNumber,
  totalDays,
  isActive,
} = Astro.props;

// Format date range: "20–26 sep"
const fmtShort = (iso: string) => {
  const d = new Date(iso + "T12:00:00");
  return d.toLocaleDateString("es-HN", { day: "numeric", month: "short" });
};
const dateRange = `${fmtShort(startDate)} – ${fmtShort(endDate)}`;

// Split feria name for line-break typographic treatment
// "Feria Patronal de San Marcos" → "Feria Patronal" / "de San Marcos"
const nameParts = feriaName.split(" de ");
const nameLine1 = nameParts[0];          // "Feria Patronal"
const nameLine2 = nameParts[1] ?? "";    // "San Marcos"
---

<section class="hero" aria-label="Bienvenida a la Feria Patronal">
  <!-- Background image -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="/hero.jpg"
      alt=""
      class="hero-img"
      loading="eager"
      fetchpriority="high"
      width="1400"
      height="788"
    />
    <!-- Gradiente oscuro para legibilidad del texto -->
    <div class="hero-overlay"></div>
  </div>

  <!-- Content -->
  <div class="hero-content container">
    <!-- Eyebrow: estado actual -->
    <div class="hero-eyebrow">
      {isActive ? (
        <span class="badge badge--fire hero-status-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          En vivo · Día {currentDayNumber} de {totalDays}
        </span>
      ) : (
        <span class="badge badge--outline-light">
          Próximamente
        </span>
      )}
    </div>

    <!-- Título principal -->
    <div class="hero-title-block">
      <p class="hero-pre">Feria Patronal</p>
      <h1 class="hero-title">
        <span class="hero-title-line1">de San Marcos</span>
        <span class="hero-title-year">{year}</span>
      </h1>
    </div>

    <!-- Meta: lugar + fechas -->
    <p class="hero-meta">
      <span>{town}</span>
      <span class="hero-meta-sep" aria-hidden="true">·</span>
      <span>{dateRange}</span>
    </p>

    <!-- CTA -->
    <div class="hero-cta">
      <a href="#hoy" class="btn-primary hero-btn">
        Ver programa de hoy
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="hero-btn-icon" aria-hidden="true">
          <path fill-rule="evenodd" d="M8 2a.75.75 0 0 1 .75.75v8.69l3.22-3.22a.75.75 0 1 1 1.06 1.06l-4.5 4.5a.75.75 0 0 1-1.06 0l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.22 3.22V2.75A.75.75 0 0 1 8 2Z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* ─── Container ──────────────────────────────────── */
  .hero {
    position: relative;
    /* Altura: suficiente para impacto visual, no tan alta que empuje el contenido */
    min-height: clamp(420px, 72vh, 580px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end; /* contenido en la parte inferior */
  }

  /* ─── Background ─────────────────────────────────── */
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%; /* foco en la parte superior */
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    /* Gradiente que oscurece más abajo donde va el texto */
    background: linear-gradient(
      to bottom,
      rgb(15 10 5 / 0.25) 0%,
      rgb(15 10 5 / 0.45) 40%,
      rgb(15 10 5 / 0.85) 80%,
      rgb(15 10 5 / 0.95) 100%
    );
  }

  /* ─── Content ────────────────────────────────────── */
  .hero-content {
    position: relative;
    z-index: 1;
    color: var(--color-cream-warm);
    padding-bottom: 2.5rem;
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  /* Eyebrow */
  .hero-eyebrow {
    display: flex;
    align-items: center;
  }

  .hero-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    flex-shrink: 0;
    /* Pulso sutil */
    animation: pulse 2s ease infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1;   scale: 1;    }
    50%       { opacity: 0.6; scale: 0.85; }
  }

  /* Título */
  .hero-title-block {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hero-pre {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fire-light);
    margin: 0 0 0.25rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 11vw, 4.5rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.025em;
    color: #fff;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hero-title-line1 {
    display: block;
  }

  .hero-title-year {
    display: block;
    color: var(--color-gold);
    font-style: italic;
  }

  /* Meta */
  .hero-meta {
    font-size: 0.9375rem;
    color: rgb(245 240 232 / 0.75);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .hero-meta-sep {
    color: rgb(245 240 232 / 0.4);
  }

  /* CTA */
  .hero-cta {
    margin-top: 0.25rem;
  }

  .hero-btn {
    width: 100%;
    justify-content: center;
  }

  .hero-btn-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  /* ─── Responsive ─────────────────────────────────── */
  @media (min-width: 480px) {
    .hero-btn {
      width: auto;
    }
  }
</style>
